# Nothing derived from the game is ever committed: the dump, converted ELFs, lifted C, objects, the game library,
# caches and saves are all made on the player's PC from their own dump.
/dump
/targets
/build/
/cache/
/deps/
/prebuilt/
/userdata/
/mods/
/notes/
/config/*.bak
/runtime/obj_host/
# left in older checkouts by the Python tools (gone since #110): the first is made from the dump, so never commit it
/lifter/eh_main_tables.json
**/__pycache__/
# runtime/gen/: written by wtbuild tables from the dump
/runtime/gen/
*.elf
*.nso
!/tools/wtbuild/testdata/fake_main/main.nso
!/tools/wtbuild/testdata/fake_main/sdk.nso
*.nca
*.nsp
*.xci
*.npdm
*.keys
*.pkz
*.dat
*.bxm
*.webm
*.o
*.so
*.a
*.dll
*.exe
