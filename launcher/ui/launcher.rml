<rml>
<head>
	<title>Witch Time</title>
	<link type="text/rcss" href="witch.rcss"/>
</head>
<body data-model="wt">

<!-- ======================================================================= title menu -->
<div class="screen title" data-if="screen == 'title'">
	<div class="ground"></div>
	<div class="glow"></div>
	<div class="wheel">
		<img class="ring1" src="img/wheel-ring1.bmp?a=170"/>
		<img class="ring2" src="img/wheel-ring2.bmp?a=170"/>
		<img class="base" src="img/wheel-base.bmp?a=170"/>
		<img class="gear1" src="img/wheel-gear1.bmp?a=170"/>
		<img class="gear2" src="img/wheel-gear2.bmp?a=170"/>
		<img class="gear3" src="img/wheel-gear3.bmp?a=170"/>
		<img class="top" src="img/wheel-top.bmp?a=170"/>
		<img src="img/hand-hour.bmp" data-style-transform="'rotate(' + hour_deg + 'deg)'"/>
		<img src="img/hand-minute.bmp" data-style-transform="'rotate(' + minute_deg + 'deg)'"/>
	</div>
	<div class="wedge"></div>
	<div class="stripe"><img src="img/stripe.bmp"/></div>
	<div class="rule r1"></div><div class="rule r2"></div>
	<img class="logo" src="img/logo.bmp"/>
	<div data-for="m, i : menu" class="mi autofocus" data-class-dim="m.dim" data-style-left="(70 + 26 * i) + 'dp'" data-style-top="(330 + 50 * i) + 'dp'" data-event-click="menu(i)">
		<div class="halo"></div><div class="fill"></div><div class="chev">»</div>
		<span>{{ m.label }}</span><span class="tag" data-if="m.tag != ''">{{ m.tag }}</span>
	</div>
	<div class="band" data-class-bad="status_bad">{{ status_line }}</div>
	<div class="foot">
		<div class="fl">{{ footer_info }}</div>
		<div class="grow"></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_ok"/><span>OK</span></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
	</div>
</div>

<!-- ======================================================================= first run: the dump -->
<div class="screen wide" data-if="screen == 'setup'">
	<div class="ground"></div>
	<div class="glow"></div>
	<div class="wedge"></div>
	<div class="wheel dark">
		<img class="ring1" src="img/wheel-dark-ring1.bmp?a=85"/>
		<img class="ring2" src="img/wheel-dark-ring2.bmp?a=85"/>
		<img class="base" src="img/wheel-dark-base.bmp?a=85"/>
		<img class="gear1" src="img/wheel-dark-gear1.bmp?a=85"/>
		<img class="gear2" src="img/wheel-dark-gear2.bmp?a=85"/>
		<img class="gear3" src="img/wheel-dark-gear3.bmp?a=85"/>
		<img class="top" src="img/wheel-dark-top.bmp?a=85"/>
		<img src="img/hand-hour.bmp?a=85" data-style-transform="'rotate(' + hour_deg + 'deg)'"/>
		<img src="img/hand-minute.bmp?a=85" data-style-transform="'rotate(' + minute_deg + 'deg)'"/>
	</div>
	<div class="stripe"><img src="img/stripe.bmp"/></div>
	<div class="rule r1"></div><div class="rule r2"></div>
	<div class="plate"><span class="crumb" data-event-click="go('title')">Witch Time</span><span class="sep"></span><span>{{ built ? 'Your dump' : 'First run' }}</span></div>
	<div class="lead-block">
		<h2>Point the launcher at your dump</h2>
		<div class="flourish"></div>
		<p>A folder holding <em>exefs</em> and <em>romfs</em> that you extracted from your own console. Nothing is downloaded, decrypted or sent anywhere.</p>
		<p>The launcher turns your copy's code into a native program on this PC. You do this once; updates rebuild only what changed.</p>
	</div>
	<div class="col">
		<div class="label">DUMP FOLDER</div>
		<div class="field-row">
			<input type="text" class="text autofocus" data-value="dump"/>
			<div class="btn" data-event-click="browse()"><div class="fill"></div><span>Browse</span></div>
		</div>
		<div class="row">
			<div class="switch" data-class-on="move_dump" data-event-click="toggle_move()"><div class="knob"></div></div>
			<div class="what"><div class="name">{{ move_dump ? 'Move the game data here' : 'Copy the game data here' }}</div><div class="note">{{ move_dump ? 'The romfs leaves your dump folder for the game folder; nothing is stored twice.' : 'Your dump stays whole: free on the same drive, about 15 GB from another.' }}</div></div>
		</div>
		<div class="row" data-if="dump_modified || accept_modified">
			<div class="switch" data-class-on="accept_modified" data-event-click="toggle_accept_modified()"><div class="knob"></div></div>
			<div class="what"><div class="name">Use a modified dump</div><div class="note">Some files differ from the supported version (another version, or mods). It may build and run, or it may not; it is unsupported.</div></div>
		</div>
		<div class="rows">
			<div data-for="c : checks" class="row" data-class-done="c.state == 'done'" data-class-run="c.state == 'run'" data-class-wait="c.state == 'wait'" data-class-fail="c.state == 'fail'">
				<div class="diamond"></div>
				<div class="grow">{{ c.text }}</div>
				<div class="right">{{ c.right }}</div>
			</div>
		</div>
		<div class="actions" style="position: relative; left: 0; top: 0;">
			<div class="btn primary" data-if="!verified" data-event-click="check_dump()"><div class="fill"></div><span>{{ checking ? 'Checking…' : 'Check dump' }}</span></div>
			<div class="btn primary" data-if="verified" data-event-click="start_build()"><div class="fill"></div><span>Begin build</span></div>
		</div>
	</div>
	<div class="band">{{ verified ? 'Your dump checks out. Begin the build.' : 'Choose the folder, then check the dump.' }}</div>
	<div class="foot">
		<div class="fl">About 15 minutes on 16 threads  ·  About 9 GB of free space  ·  Close the window any time; it resumes</div>
		<div class="grow"></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_ok"/><span>OK</span></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
	</div>
</div>

<!-- ======================================================================= building -->
<div class="screen build" data-if="screen == 'build'">
	<div class="ground"></div>
	<div class="glow"></div>
	<div class="wheel">
		<img class="ring1" src="img/wheel-ring1.bmp?a=150"/>
		<img class="ring2" src="img/wheel-ring2.bmp?a=150"/>
		<img class="base" src="img/wheel-base.bmp?a=150"/>
		<img class="gear1" src="img/wheel-gear1.bmp?a=150"/>
		<img class="gear2" src="img/wheel-gear2.bmp?a=150"/>
		<img class="gear3" src="img/wheel-gear3.bmp?a=150"/>
		<img class="top" src="img/wheel-top.bmp?a=150"/>
	</div>
	<img class="track" src="gen:ring?c=24202e&amp;a=24&amp;w=22"/>
	<progress direction="clockwise" start-edge="top" data-attr-value="progress"></progress>
	<div class="wedge" style="width: 640dp;"></div>
	<div class="stripe" style="left: 340dp;"><img src="img/stripe.bmp"/></div>
	<div class="rule r1" style="left: 390dp;"></div><div class="rule r2" style="left: 395dp;"></div>
	<div class="plate"><span class="crumb" data-event-click="go('title')">Witch Time</span><span class="sep"></span><span>Building</span></div>
	<div data-for="s, i : steps" class="mi" data-class-on="s.state == 'run'" data-class-run="s.state == 'run'" data-class-dim="s.state == 'wait'" data-class-fail="s.state == 'fail'" data-style-left="(60 + 36 * i) + 'dp'" data-style-top="(170 + 70 * i) + 'dp'" style="width: 300dp;">
		<div class="halo"></div><div class="fill"></div><div class="chev">»</div>
		<span class="num">{{ s.num }}</span><div class="lbl"><div>{{ s.name }}</div></div>
		<span class="dia" data-if="s.state == 'done'"></span>
	</div>
	<div class="readout">
		<div class="pct">{{ percent }}<span>%</span></div>
		<div class="aside">{{ build_aside }}</div>
	</div>
	<div class="actions">
		<div class="btn autofocus" data-if="building" data-event-click="stop_build()"><div class="fill"></div><span>Stop</span></div>
		<div class="btn primary autofocus" data-if="!building &amp;&amp; built &amp;&amp; !stale" data-event-click="play()"><div class="fill"></div><span>Play</span></div>
		<div class="btn autofocus" data-if="!building" data-event-click="start_build()"><div class="fill"></div><span>{{ built ? 'Rebuild' : 'Build' }}</span></div>
		<div class="btn" data-event-click="toggle_log()"><div class="fill"></div><span>{{ show_log ? 'Hide log' : 'Show log' }}</span></div>
	</div>
	<div class="logbox" data-if="show_log">
		<div class="error" data-if="build_error != ''">{{ build_error }}</div>
		<div data-for="l : log">{{ l }}</div>
	</div>
	<div class="band">{{ build_line }}</div>
	<div class="foot">
		<div class="grow"></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_ok"/><span>OK</span></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
	</div>
</div>

<!-- ======================================================================= mods -->
<div class="screen wide" data-if="screen == 'mods'">
	<div class="ground"></div>
	<div class="glow"></div>
	<div class="wedge"></div>
	<div class="wheel dark">
		<img class="ring1" src="img/wheel-dark-ring1.bmp?a=85"/>
		<img class="ring2" src="img/wheel-dark-ring2.bmp?a=85"/>
		<img class="base" src="img/wheel-dark-base.bmp?a=85"/>
		<img class="gear1" src="img/wheel-dark-gear1.bmp?a=85"/>
		<img class="gear2" src="img/wheel-dark-gear2.bmp?a=85"/>
		<img class="gear3" src="img/wheel-dark-gear3.bmp?a=85"/>
		<img class="top" src="img/wheel-dark-top.bmp?a=85"/>
		<img src="img/hand-hour.bmp?a=85" data-style-transform="'rotate(' + hour_deg + 'deg)'"/>
		<img src="img/hand-minute.bmp?a=85" data-style-transform="'rotate(' + minute_deg + 'deg)'"/>
	</div>
	<div class="stripe"><img src="img/stripe.bmp"/></div>
	<div class="rule r1"></div><div class="rule r2"></div>
	<div class="plate"><span class="crumb" data-event-click="go('title')">Witch Time</span><span class="sep"></span><span>Mods</span></div>
	<div class="lead-block">
		<h2>Mods</h2>
		<div class="flourish"></div>
		<p>Each mod sits in its own folder in the mods folder: code patches (<em>.pchtxt</em>, <em>.ips</em>) or a romfs folder. Turn them on or off here.</p>
		<p>Data mods apply at the next start. Code mods rebuild from the mods step.</p>
		<div class="actions">
			<div class="btn primary" data-if="mods_rebuild" data-event-click="start_build()"><div class="fill"></div><span>Apply and rebuild</span></div>
			<div class="btn" data-event-click="open_mods()"><div class="fill"></div><span>Open mods folder</span></div>
		</div>
	</div>
	<div class="col">
		<div class="rows">
			<div data-for="m, i : mods" class="row">
				<div class="switch autofocus" data-class-on="m.on" data-event-click="toggle_mod(i)"><div class="knob"></div></div>
				<div class="what"><div class="name">{{ m.name }}</div><div class="note">{{ m.note }}</div></div>
				<div class="tag">{{ m.kind }}</div>
			</div>
		</div>
		<div class="empty" data-if="mods.size == 0">No mods yet. Put each one in its own folder in the mods folder: code patches (.pchtxt, .ips) or a romfs folder.</div>
		<div class="error" data-if="mods_error != ''">{{ mods_error }}</div>
	</div>
	<div class="band">{{ mods_summary }}</div>
	<div class="foot">
		<div class="grow"></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_ok"/><span>Turn on or off</span></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
	</div>
</div>

<!-- ======================================================================= settings -->
<div class="screen wide" data-if="screen == 'settings'">
	<div class="ground"></div>
	<div class="glow"></div>
	<div class="wedge"></div>
	<div class="wheel dark">
		<img class="ring1" src="img/wheel-dark-ring1.bmp?a=85"/>
		<img class="ring2" src="img/wheel-dark-ring2.bmp?a=85"/>
		<img class="base" src="img/wheel-dark-base.bmp?a=85"/>
		<img class="gear1" src="img/wheel-dark-gear1.bmp?a=85"/>
		<img class="gear2" src="img/wheel-dark-gear2.bmp?a=85"/>
		<img class="gear3" src="img/wheel-dark-gear3.bmp?a=85"/>
		<img class="top" src="img/wheel-dark-top.bmp?a=85"/>
		<img src="img/hand-hour.bmp?a=85" data-style-transform="'rotate(' + hour_deg + 'deg)'"/>
		<img src="img/hand-minute.bmp?a=85" data-style-transform="'rotate(' + minute_deg + 'deg)'"/>
	</div>
	<div class="stripe"><img src="img/stripe.bmp"/></div>
	<div class="rule r1"></div><div class="rule r2"></div>
	<div class="plate"><span class="crumb" data-event-click="go('title')">Witch Time</span><span class="sep"></span><span>Settings</span></div>
	<div class="lead-block">
		<h2>Settings</h2>
		<div class="flourish"></div>
		<p>The same rows as the game's PC Settings panel (F1, or Start + Select), saved to the config folder as you change them.</p>
		<p data-if="tab == 0">The window, the display and the frame rate.</p>
		<p data-if="tab == 1">What the game draws and how sharply.</p>
		<p data-if="tab == 2">Prompts and menu buttons. Every button of gameplay is rebound in the game's panel, under Controls.</p>
		<p data-if="tab == 1">{{ tex_note }}</p>
	</div>
	<div class="tabs">
		<img class="gl" data-attr-src="glyph_tab_l" data-event-click="tab(tab - 1)"/>
		<div class="tab" data-class-on="tab == 0" data-event-click="tab(0)"><div>Display</div></div>
		<div class="tab" data-class-on="tab == 1" data-event-click="tab(1)"><div>Graphics</div></div>
		<div class="tab" data-class-on="tab == 2" data-event-click="tab(2)"><div>Controls</div></div>
		<img class="gl" data-attr-src="glyph_tab_r" data-event-click="tab(tab + 1)"/>
	</div>
	<div data-for="s, i : settings" class="srow setting autofocus" data-attr-index="s.index" data-style-left="(620 + 26 * i) + 'dp'" data-style-top="(110 + 56 * i) + 'dp'">
		<div class="fill"></div><div class="chev">»</div>
		<div class="k"><div>{{ s.name }}</div><div class="note">{{ s.note }}</div></div>
		<span class="v"><span class="arrow" data-event-click="setting(s.index, -1)">‹</span><span class="value">{{ s.value }}</span><span class="arrow" data-event-click="setting(s.index, 1)">›</span></span>
	</div>
	<div class="srow" data-if="tab == 1" data-style-left="(620 + 26 * settings.size) + 'dp'" data-style-top="(110 + 56 * settings.size) + 'dp'">
		<div class="fill"></div>
		<div class="k"><div>Converted textures</div><div class="note">{{ tex_action != '' ? 'Not made yet' : tex_remove ? 'In use' : 'Not available' }}</div></div>
		<span class="v">
			<div class="btn light" data-if="tex_action != ''" data-event-click="convert_textures()"><div class="fill"></div><span>{{ tex_action }}</span></div>
			<div class="btn light" data-if="tex_remove" data-event-click="remove_textures()"><div class="fill"></div><span>Remove</span></div>
		</span>
	</div>
	<div class="band">Changes are saved as you make them.</div>
	<div class="foot">
		<div class="grow"></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_tab_l"/><img class="gl" data-attr-src="glyph_tab_r"/><span>Section</span></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_change"/><span>Change</span></div>
		<div class="hint"><img class="gl" data-attr-src="glyph_back"/><span>Back</span></div>
	</div>
</div>

</body>
</rml>
